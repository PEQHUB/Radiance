  "bugs": {
    "p0": [
      {
        "id": "BUG-001",
        "title": "SelectionDropdownWidget static list memory leak",
        "file": "src/main/java/com/radiance/client/gui/SelectionDropdownWidget.java",
        "line": 20,
        "detail": "ALL_DROPDOWNS ArrayList grows unbounded. clearInstances() is never called. Stale widget references accumulate, holding references to dead screens.",
        "impact": "OOM over time, GC pressure spikes/stutter",
        "fix": "Call SelectionDropdownWidget.clearInstances() in ContentPanelWidget.clearContent()"
      },
      {
        "id": "BUG-002",
        "title": "Phantom click interception from dead dropdowns",
        "file": "src/main/java/com/radiance/client/gui/SelectionDropdownWidget.java",
        "line_range": [72, 83],
        "detail": "Stale widgets in ALL_DROPDOWNS with open=true intercept clicks via handleOverlayClick, silently swallowing user input.",
        "impact": "User clicks silently eaten by invisible dead widgets",
        "fix": "Same as BUG-001 — clearing the static list prevents stale interception"
      }
    ],
    "p1": [
      {
        "id": "BUG-003",
        "title": "Reset to Defaults doesn't persist to disk",
        "file": "src/main/java/com/radiance/client/gui/unified/RadianceUnifiedScreen.java",
        "line_range": [98, 101],
        "detail": "resetAllToDefaults() pushes values to C++ via JNI but never calls Options.overwriteConfig(). Values revert on restart.",
        "impact": "User expects reset to persist, values silently revert on next launch",
        "fix": "Add Options.overwriteConfig() after Options.resetAllToDefaults()"
      },
      {
        "id": "BUG-004",
        "title": "Escape cancels material edits silently",
        "file": "src/main/java/com/radiance/client/gui/MaterialsSettingsScreen.java",
        "line_range": [463, 468],
        "detail": "close() calls cancelChanges() which calls restoreSnapshot(), reverting all edits. Pressing Escape instead of Apply silently reverts all material work.",
        "impact": "User loses all material edits by pressing Escape",
        "fix": "Either auto-save on close, prompt user to save/discard, or make Escape behave like Apply"
      },
      {
        "id": "BUG-005",
        "title": "Scroll changes NoiseType when dropdown is closed",
        "file": "src/main/java/com/radiance/client/gui/NoiseTypeDropdownWidget.java",
        "line_range": [210, 219],
        "detail": "mouseScrolled() fires onSelect.accept(selected) even when dropdown is closed. Scrolling the page silently mutates noise type.",
        "impact": "Unintentional setting change via scroll",
        "fix": "Guard with if (!open) return false"
      }
    ],
    "p2": [
      {
        "id": "BUG-006",
        "title": "Space key hijacks search overlay — can't type spaces in text fields",
        "file": "src/main/java/com/radiance/client/gui/unified/RadianceUnifiedScreen.java",
        "line_range": [509, 511],
        "detail": "keyPressed unconditionally consumes GLFW_KEY_SPACE to toggle search overlay, even when a text field has focus.",
        "fix": "Check if any child widget has focus before consuming Space"
      },
      {
        "id": "BUG-007",
        "title": "Tab always triggers peek mode, search cycling is dead code",
        "file": "src/main/java/com/radiance/client/gui/MaterialsSettingsScreen.java",
        "line_range": [381, 387],
        "detail": "handlePeekKeyPressed on line 381 consumes Tab first. Tab-based search cycling code on line 387 is unreachable.",
        "fix": "Reverse priority or use a different key for peek mode"
      },
      {
        "id": "BUG-008",
        "title": "Right-click precision drag broken in overlay screens",
        "file": "src/main/java/com/radiance/client/gui/unified/RadianceUnifiedScreen.java",
        "line_range": [544, 556],
        "detail": "When overlay is showing, mouseDragged delegates to overlayScreen but right-click drag logic at line 551-553 never fires because overlay check at line 546 returns first.",
        "fix": "Forward button 1 drag events through overlay delegation path"
      },
      {
        "id": "BUG-009",
        "title": "Smooth scroll visual/hitbox desync",
        "file": "src/main/java/com/radiance/client/gui/WideOptionListWidget.java",
        "line_range": [57, 62],
        "detail": "renderWidget uses displayScrollY for visuals but hit-testing uses getScrollY() (target value). During scroll animation, clicks hit wrong entries.",
        "fix": "Use displayScrollY for hit-testing during animation, or snap scroll on click"
      },
      {
        "id": "BUG-010",
        "title": "RenderPipelineScreen header buttons have wrong click targets",
        "file": "src/main/java/com/radiance/client/gui/RenderPipelineScreen.java",
        "line_range": [399, 404],
        "detail": "mouseClicked divides coords by GLOBAL_SCALE before passing to super.mouseClicked(), but header buttons were positioned unscaled. Buttons only clickable at 60% of their visual position.",
        "fix": "Pass unscaled coordinates to super.mouseClicked() for header buttons"
      },
      {
        "id": "BUG-011",
        "title": "No error feedback on invalid numeric input",
        "file": "src/main/java/com/radiance/client/gui/NumericSliderInputScreen.java",
        "line_range": [53, 61],
        "detail": "submit() catches NumberFormatException silently. No visual feedback when user types non-numeric values.",
        "fix": "Show error text or flash the input field red on invalid input"
      }
    ],
    "p3": [
      {
        "id": "BUG-012",
        "title": "Search overlay is non-functional — traps keyboard input",
        "file": "src/main/java/com/radiance/client/gui/unified/UnifiedSearchOverlay.java",
        "detail": "Records typed characters but never searches. Returns true for ALL key events, consuming input. Comment says 'full implementation was lost during branch cleanup.'",
        "fix": "Either implement search or remove the overlay and Space key binding"
      },
      {
        "id": "BUG-013",
        "title": "Enter on tree category does nothing visible",
        "file": "src/main/java/com/radiance/client/gui/unified/TreeNavigationWidget.java",
        "line_range": [294, 303],
        "detail": "Enter sets node.expanded=true but doesn't fire onSelect callback. User presses Enter expecting to see content.",
        "fix": "Call selectFlatNode after expanding, or fire onSelect for category nodes with populators"
      },
      {
        "id": "BUG-014",
        "title": "Double-click on MaterialBrowser uses raw millis with no distance check",
        "file": "src/main/java/com/radiance/client/gui/MaterialBrowserScreen.java",
        "line_range": [704, 711],
        "detail": "400ms window with System.currentTimeMillis(). Two intentional single clicks on same cell can trigger Apply unintentionally.",
        "fix": "Add minimum distance check or reduce window to 250ms"
      }
    ]
  },
